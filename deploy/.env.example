# Copy to deploy/.env and fill in. Shared by every tester container.
# Never commit deploy/.env. Placeholders only in this file.

# The public hostname; its DNS A record must point at this machine.
DOMAIN=brian.example.com

GEMINI_API_KEY=your-gemini-key
OPENAI_API_KEY=your-openai-key
ELEVENLABS_API_KEY=your-elevenlabs-key
ELEVENLABS_VOICE_ID=your-voice-id
