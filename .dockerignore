# Build context is the repo root (Dockerfile). Only pyproject.toml, src/ and
# backend/ are copied; this keeps secrets, local state and bulk out of the context.
.git
**/node_modules
dashboard/.next
dashboard
**/.venv
**/__pycache__
**/*.pyc
**/.ruff_cache
**/.pytest_cache
**/.env
**/.env.*
!backend/.env.example
data/
backend/data/
.claude/
ios/
corpus/
runs/
**/*.db
**/*.db-wal
**/*.db-shm
**/*.sqlite3
