      "Bash(xcrun *)",
      "Bash(xcode-select *)",
      "Bash(swift *)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(cd backend && uv run *)",
      "Bash(cd ios/Brian && *)",
