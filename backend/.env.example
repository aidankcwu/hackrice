OPENAI_API_KEY=
T1_MODEL=gpt-5.4-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SAz9YHcvj6GT2YYXdXww
SPEECH_MODE=auto
DEMO_MODE=1
DB_PATH=./data/pipeline.db
# Seconds between ticks off the capture path (Person A's glasses: 1.5 s).
TICK_INTERVAL_S=1.5
KEYWORD_TRIGGERS_JSON=[{"name":"rice_krispy","keywords":["rice krispy","rice krispie","krispy treat","krispie treat","crispy treat","rice crispy"],"note":"the wearer wants a reaction when someone is eating Rice Krispy treats","cooldown_s":60}]
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_REDIRECT_URI=http://localhost:8010/api/wearables/fitbit/callback
FITBIT_TOKEN_PATH=./data/fitbit_token.json
FITBIT_POLL_S=300
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:8010/api/wearables/google-health/callback
GOOGLE_HEALTH_TOKEN_PATH=./data/google_health_token.json
GOOGLE_HEALTH_POLL_S=300
WEARABLE_INGEST_TOKEN=
# Deployment (docs/DEPLOY.md). API_TOKEN guards /api/* and /ws/glasses; empty = off.
API_TOKEN=
CORS_ORIGINS=http://localhost:3000
# CLI defaults when no flag is given: SOURCE=sim REASONER=fake VLM=gemini PORT=8010
VLM_BUDGET_S=
# Air quality (OpenAQ v3). Leave AIR_LAT/AIR_LON empty and pm25 stays unmeasured.
AIR_LAT=
AIR_LON=
AIR_OPENAQ_KEY=
AIR_POLL_S=3600
# Healthspan profile (scoring/brian_score.Profile); bedtime comes from seeded bed_time.
PROFILE_AGE=20
PROFILE_SEX=M
PROFILE_GOAL=average
PROFILE_CYP1A2_SLOW=0
# PROFILE_HEIGHT_M=1.78
# Autopilot acts (pipeline/actions/autopilot.py). AUTOPILOT_ACTS: kinds allowed to
# reach the phone; empty = autopilot off. AUTOPILOT_QUIET_DAYS: weekdays with no
# acts, 0=Monday..6=Sunday (e.g. 5,6). Persona text never vetoes an act.
AUTOPILOT_ACTS=calendar_block,screen_shield
AUTOPILOT_QUIET_DAYS=
# Hosted deployment (deploy/README.md). All empty = the local Mac behaviour.
# ACCESS_TOKEN: when set, /ws/glasses and every route but /healthz need it, as
# the X-Access-Token header, Authorization: Bearer <token>, or ?token= (checked
# in that order; the first one present is the one compared). Empty = open
# (localhost dev). API_TOKEN is read as a legacy alias; set only one, since
# both set to different values refuses to start.
ACCESS_TOKEN=
# HOSTED=1: hosted safety checks (non-empty token required; the Fitbit and
# Google Health OAuth callbacks answer 409, wearable login is unsupported).
# HOSTED=0
# PERSONA_FILE: text file loaded into the persona at startup if the DB has none.
PERSONA_FILE=
# DEMO_RESET_ON_START=1 clears conversations/questions/sessions at each start.
DEMO_RESET_ON_START=0
# Comma-separated browser origins allowed to call the API ("*" for any).
CORS_ORIGINS=http://localhost:3000
# Public prefix the reverse proxy strips, e.g. /t/alice. Empty when direct.
ROOT_PATH=
